{
    "name": "fiber-interop/swoole",
    "description": "Swoole coroutine adapter for fiber-interop/api: go, await, sleep, readable, writable on Swoole coroutines.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "fiber-interop/api": "^0.2",
        "fiber-interop/scope": "^0.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11"
    },
    "suggest": {
        "ext-swoole": "Swoole 6.x (required, or ext-openswoole; Composer cannot express the either-or, so neither is hard-required)"
    },
    "autoload": {
        "psr-4": {
            "FiberInterop\\Swoole\\": "src/"
        },
        "files": [
            "src/register.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "FiberInterop\\Swoole\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {}
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "0.2.x-dev"
        }
    }
}
